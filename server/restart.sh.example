#!/bin/bash
set -euo pipefail

# Configuration template - copy to restart.sh and update paths
PROCESS_NAME="lyre-server"
APP_DIR="${APP_DIR:-/home/user/lyre}"
SCRIPT_PATH="${APP_DIR}/server.py"

LOG_FILE="${APP_DIR}/log.txt"
PID_FILE="${APP_DIR}/pidfile.pid"

PYTHON_EXEC="${PYTHON_EXEC:-python3}"

echo "Restarting server..."

start-stop-daemon --stop --oknodo --pidfile "$PID_FILE"

sleep 1

start-stop-daemon --start --background \
    --pidfile "$PID_FILE" --make-pidfile \
    --exec "$PYTHON_EXEC" \
    --no-close \
    -- "$SCRIPT_PATH" > "$LOG_FILE" 2>&1

echo "Server restarted."

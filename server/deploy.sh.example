#!/bin/bash
set -euo pipefail

# Configuration template - copy to deploy.sh and update variables
DEPLOY_USER="${DEPLOY_USER:-user}"
DEPLOY_HOST="${DEPLOY_HOST:-127.0.0.1}"
DEPLOY_PORT="${DEPLOY_PORT:-22}"
REMOTE_PATH="${REMOTE_PATH:-/home/user/lyre}"

echo "Deploying to ${DEPLOY_USER}@${DEPLOY_HOST}:${REMOTE_PATH}..."

scp -P "${DEPLOY_PORT}" ./server.py "${DEPLOY_USER}@${DEPLOY_HOST}:${REMOTE_PATH}/"
ssh -p "${DEPLOY_PORT}" "${DEPLOY_USER}@${DEPLOY_HOST}" "bash ${REMOTE_PATH}/restart.sh"

echo "Deployment complete."
